
// To jest "pośrednik" - pobiera CSV z Dysku Google po stronie serwera
// (gdzie nie ma blokady CORS) i przekazuje go dalej do Twojej strony.
export default async function handler(req, res) {
  const FILE_ID = "1pgQo9w7G3zvzNBU0t8fEWdcS7jC73QNZ";
  const csvUrl = `https://drive.google.com/uc?export=download&id=${FILE_ID}`;
  try {
    const response = await fetch(csvUrl);
    if (!response.ok) {
      return res.status(response.status).json({ error: `Dysk Google zwrócił błąd: ${response.status}` });
    }
    const csvText = await response.text();
 
    // Jeśli plik jest większy (Google czasem pokazuje stronę ostrzegawczą
    // zamiast pliku), zwracana treść będzie HTML-em zamiast CSV - wychwytujemy to.
    if (csvText.trim().startsWith("<!DOCTYPE html") || csvText.trim().startsWith("<html")) {
      return res.status(502).json({
        error: "Dysk Google zwrócił stronę HTML zamiast pliku CSV. Sprawdź, czy plik jest udostępniony jako \"Każda osoba mająca link\" oraz czy nie jest zbyt duży (Google wtedy pokazuje ostrzeżenie o skanie antywirusowym)."
      });
    }
 
    // Zezwól przeglądarce na odczyt tej odpowiedzi (to właśnie naprawia CORS)
    res.setHeader("Access-Control-Allow-Origin", "*");
    res.setHeader("Content-Type", "text/csv; charset=utf-8");
    // Krótkie cachowanie, żeby nie odpytywać Dysku Google przy każdym wejściu na stronę
    res.setHeader("Cache-Control", "s-maxage=300, stale-while-revalidate=600");
    res.status(200).send(csvText);
  } catch (err) {
    res.status(500).json({ error: "Nie udało się pobrać danych z Dysku Google: " + err.message });
  }
}
 
